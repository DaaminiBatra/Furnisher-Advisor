# Copy to .env for local development. Never commit the real .env.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///./dev.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Optional: password-reset emails. Leave SMTP_HOST empty to just log the link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
